# Copy to .env (git-ignored) in the repo root, or use `dotnet user-secrets` instead (see README).
# A double underscore is a nested config key: PayPal__ClientId -> PayPal:ClientId.
# Comments must be on their own line.

# PayPal sandbox REST app: developer.paypal.com -> Apps & Credentials -> Sandbox -> your app
PayPal__ClientId=
PayPal__ClientSecret=

# LLM provider: Claude or Gemini (only the selected provider's key is needed)
Llm__Provider=Claude
Llm__Claude__ApiKey=
# Llm__Claude__Model=claude-opus-5-5
# Llm__Claude__Effort=medium
Llm__Gemini__ApiKey=
# Llm__Gemini__Model=gemini-flash-latest

# Seed tool (optional)
# Sandbox test card used for scripted orders; generate another in the developer dashboard if it is declined.
# Seed__CardNumber=4111111111111111
# Sandbox personal (buyer) account email to receive the demo invoices.
# Seed__BuyerEmail=
# Skip the card flow and create orders that the sandbox buyer approves by hand.
# Seed__SkipCard=true
