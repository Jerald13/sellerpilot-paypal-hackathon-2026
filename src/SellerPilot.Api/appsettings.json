{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SellerPilot": "Data Source=sellerpilot.db"
  },
  "PayPal": {
    "BaseUrl": "https://api-m.sandbox.paypal.com",
    "ClientId": "",
    "ClientSecret": "",
    "TimeoutSeconds": 20,
    "MaxRetries": 2
  },
  "Llm": {
    "Provider": "Claude",
    "TimeoutSeconds": 120,
    "Claude": {
      "ApiKey": "",
      "Model": "claude-opus-5-5",
      "Effort": "medium",
      "MaxTokens": 16000,
      "UseServerSideFallback": true
    },
    "Gemini": {
      "ApiKey": "",
      "Model": "gemini-flash-latest",
      "MaxOutputTokens": 8192
    }
  },
  "Agent": {
    "MaxToolIterations": 6,
    "MaxToolCallsPerIteration": 10,
    "MaxUserMessageLength": 2000,
    "MaxHistoryMessages": 60
  },
  "Guardrails": {
    "MaxRefundAmount": {
      "USD": 500,
      "SGD": 650,
      "MYR": 2200
    },
    "RefundWindowDays": 180,
    "ReminderCooldownHours": 24
  }
}
